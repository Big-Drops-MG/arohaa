# Template only — copy real values to ECS task env / Secrets Manager (never commit secrets).
# Local dev: API auto-loads apps/dashboard/.env.local when apps/api/.env.local is missing.

NODE_ENV=production
PORT=3001

# Must match dashboard / Vercel AROHAA_INTERNAL_API_SECRET
AROHAA_INTERNAL_API_SECRET=your-shared-internal-secret

# Same Neon URL as dashboard DATABASE_URL
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Same Upstash URL as dashboard REDIS_URL or KV_URL
REDIS_URL=rediss://default:UPSTASH_TOKEN@your-instance.upstash.io:6379

# Same ClickHouse Cloud as dashboard
CLICKHOUSE_URL=https://YOUR-SERVICE.region.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password

# CloudWatch logs (prefer ECS task IAM role over long-lived keys)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional
# SENTRY_DSN=

# Web push (Model B): encrypts VAPID private keys if set; else AUTH_SECRET / NEXTAUTH_SECRET from dashboard env.
# WEB_PUSH_VAPID_ENCRYPTION_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:ops@arohaa.net

# Masked click redirect base (serves GET /r/:token). Defaults to INGEST_BASE_URL / localhost in dev.
# WEB_PUSH_CLICK_BASE_URL=https://api.arohaa.net

# Optional S3 media uploads live on the dashboard; worker/API only need click base + VAPID crypto above.
# WEB_PUSH_MEDIA_S3_BUCKET=arohaa-web-push-media
# WEB_PUSH_MEDIA_S3_REGION=us-east-1
# WEB_PUSH_MEDIA_CDN_BASE=https://cdn.arohaa.net

# Must match dashboard TOTP_ENCRYPTION_KEY if API ever reads TOTP (dashboard-only today).
# TOTP_ENCRYPTION_KEY=

# Optional daily GSC SEO sync (prefer dedicated GSC client; falls back to GOOGLE_*).
# GSC_GOOGLE_CLIENT_ID=
# GSC_GOOGLE_CLIENT_SECRET=
