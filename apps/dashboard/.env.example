# Template only — copy to apps/dashboard/.env.local for local dev.
# Never commit real secrets. Production: Vercel / ECS env + Secrets Manager.

# --- Core (required) ---

# Neon Postgres (pooled URL). Same value as API DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# NextAuth / Auth.js session signing (min 32 random bytes). Also accepts NEXTAUTH_SECRET.
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public dashboard URL (invite links, password reset, emails). Vercel sets VERCEL_URL if omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# Shared HMAC secret between dashboard BFF and ingest API. Must match apps/api.
AROHAA_INTERNAL_API_SECRET=your-shared-internal-secret

# Ingest API base URL (server-side analytics proxy). Dev default: http://127.0.0.1:3001
INGEST_BASE_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_AROHAA_INGEST_API_BASE=http://127.0.0.1:3001

# --- Security / auth (required in production) ---

# Encrypts TOTP secrets at rest (twoFactorSecret, pendingTwoFactorSecret).
# Generate once per environment: openssl rand -base64 32
# Required before running: pnpm --dir apps/dashboard encrypt:totp-secrets
TOTP_ENCRYPTION_KEY=

# Comma-separated emails promoted to superadmin on first Google sign-in (internal domain only).
SUPERADMIN_BOOTSTRAP_EMAILS=you@bigdropsmarketing.com

# Google OAuth (optional — internal team SSO)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email (required for invites, access requests, password reset) ---

AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
# AWS_SES_FROM_NAME=Arohaa
# AWS_SES_CONFIGURATION_SET=

# --- Rate limiting / sessions (required in production) ---

# Upstash Redis REST (auth rate limits, optional session adapter)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternative Redis URL (some services). API uses REDIS_URL; dashboard may use KV_* above.
# REDIS_URL=rediss://default:TOKEN@your-instance.upstash.io:6379

# --- Analytics data layer (optional locally; required for full dashboard) ---

# ClickHouse Cloud (same as API)
# CLICKHOUSE_URL=https://YOUR-SERVICE.region.aws.clickhouse.cloud:8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# --- Local / CI only ---

# NODE_ENV=development

# Playwright E2E (CI)
# PLAYWRIGHT_BASE_URL=https://dev.arohaa.net
# PLAYWRIGHT_API_BASE_URL=https://api.arohaa.net
# PLAYWRIGHT_SKIP_WEBSERVER=1
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_TOTP_SECRET=

# Dev-only password reset bypass (never set in production)
# DEV_PASSWORD_RESET_OTP=

# Vitest ACL sweep tests use a dummy DATABASE_URL via vitest.setup.ts if unset.
# DB-backed ACL integration tests (route-acl-sweep.integration.test.ts):
# RUN_ACL_INTEGRATION=1 and a real DATABASE_URL with migrations through 0040+ applied.
