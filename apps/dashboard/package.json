{
  "name": "dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm ensure:geo && next dev --webpack -p 3000",
    "ensure:geo": "node -e \"const fs=require('fs');const paths=['public/geo/us-states.geojson','public/geo/us-counties.geojson'];if(!paths.every(p=>fs.existsSync(p))){const {execSync}=require('child_process');execSync('pnpm --dir ../.. geo:build',{stdio:'inherit'})}\"",
    "prebuild": "pnpm --dir ../.. geo:build",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "email:dev": "react-email dev --dir ./emails/templates",
    "email:export": "react-email export --dir ./emails/templates --outDir ./emails/dist"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@auth/upstash-redis-adapter": "^2.11.2",
    "@aws-sdk/client-sesv2": "3.1045.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.8",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.37.0",
    "@workspace/database": "workspace:^",
    "@workspace/lp-core": "workspace:*",
    "@workspace/ui": "workspace:*",
    "bcryptjs": "^3.0.3",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.34.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-email": "6.1.1",
    "recharts": "^3.8.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@react-email/ui": "6.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^3.0.0",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
