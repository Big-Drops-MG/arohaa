NODE_ENV=production
REDIS_URL=redis://...
CLICKHOUSE_URL=https://...
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Required for web-push: due-poll + VAPID decrypt (same Neon + key as dashboard/API)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
WEB_PUSH_VAPID_ENCRYPTION_KEY=
# Fallback if WEB_PUSH_VAPID_ENCRYPTION_KEY unset (must match dashboard encryption)
AUTH_SECRET=
WEB_PUSH_CLICK_BASE_URL=https://api.arohaa.net
WEB_PUSH_VAPID_SUBJECT=mailto:ops@arohaa.net

AROHAA_INTERNAL_API_SECRET=
SENTRY_DSN=
